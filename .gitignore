cat > .gitignore << 'EOF'
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Build folders
build/
/build/
android/app/build/
android/build/
android/.gradle/
android_N/app/build/

# iOS build
ios/build/
ios/Pods/
ios/.symlinks/

# Videos and large assets
assets/video/

# Zip files
*.zip
android/gradle-*.zip

# Web related
lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json
EOF